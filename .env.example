# =============================================================================
# LAITS EDU TECH — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure values for your environment:
#   cp .env.example .env
#
# CRITICAL SECURITY RULES:
# 1. Any variable starting with VITE_ is bundled into the client build and is PUBLIC.
# 2. NEVER put SUPABASE_SERVICE_ROLE_KEY or database passwords in .env.
# 3. SUPABASE_SERVICE_ROLE_KEY must ONLY be set in server-side Edge Functions / Deno secrets.
# =============================================================================

# Public: Supabase Project URL (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public: Supabase Anonymous Publishable Key (Required)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Enable Google OAuth button in the authentication UI (true / false)
VITE_ENABLE_GOOGLE_OAUTH=false

# Optional: Application Public Base URL (for email callbacks and notifications)
# Defaults to window.location.origin if unset
VITE_APP_URL=http://localhost:5173
